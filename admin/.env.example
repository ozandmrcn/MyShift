# Bu dosya_example'dır; actual yapılandırma root .env裡面dir (tek .env).
# Admin panel root .env dosyasını otomatik yükler.
# MODEL = "../../.env"
#
# Gerekli (root .env içinde):
# FIREBASE_ADMIN_SERVICE_ACCOUNT  (veya FIREBASE_ADMIN_PROJECT_ID/CLIENT_EMAIL/PRIVATE_KEY)
#
# Opsiyonel:
# ADMIN_PORT=5100                  (varsayılan 5100)
# FIREBASE_ADMIN2_*                (ikinci proje; panelde seçim menüsü belirir)